        "partitions": [
          {
            "name": "CostSummary-partition",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "gold_cost_summary",
              "schemaName": "dbo",
              "expressionSource": "DatabaseQuery"
            }
          }
        ],
        "measures": [
          {
            "name": "TotalCost",
            "expression": "SUM(CostSummary[monthly_cost])",
            "formatString": "$#,0.00;($#,0.00);$#,0.00",
            "lineageTag": "measure-total-cost"
          },
          {
            "name": "AvgMonthlyCost",
            "expression": "AVERAGEX(VALUES(CostSummary[date]), [TotalCost])",
            "formatString": "$#,0.00;($#,0.00);$#,0.00",
            "lineageTag": "measure-avg-monthly-cost"
          },
          {
            "name": "CostYTD",
            "expression": "TOTALYTD([TotalCost], Calendar[Date])",
            "formatString": "$#,0.00;($#,0.00);$#,0.00",
            "lineageTag": "measure-cost-ytd"
          },
          {
            "name": "CostMoMChange",
            "expression": "VAR CurrentPeriodCost = [TotalCost] VAR PriorPeriodCost = CALCULATE([TotalCost], DATEADD(Calendar[Date], -1, MONTH)) RETURN DIVIDE(CurrentPeriodCost - PriorPeriodCost, PriorPeriodCost)",
            "formatString": "0.00%",
            "lineageTag": "measure-cost-mom-change"
          }
        ]
      },
